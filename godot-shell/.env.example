# Copy to .env (gitignored) and set for this machine. Absolute paths; the environment overrides these.
# Optional: a command that runs its arguments where pmbootstrap is (default: tools/pmb/pmb-exec.sh).
#PMB_EXEC=/path/to/builder exec
# Optional: the pmaports tree pmbootstrap builds from (default: upstream at a pinned commit; see tools/pmb/env.sh).
#PMAPORTS_URL=https://gitlab.postmarketos.org/W-Floyd/pmaports.git
#PMAPORTS_REF=2024-kia-ev6
# scripts/unit-deploy.sh micomd: the pmaports checkout holding micomd and device-mobis-g5w, and the
# go-micomd checkout the fast path (and an unpushed commit's package) builds from.
#PMAPORTS_DIR=/path/to/pmaports
#GO_MICOMD_DIR=/path/to/go-micomd
# The head unit for scripts/unit-deploy.sh; default user@mobis-g5w.local.
#LIVI_UNIT=user@host
UNBRICK=/path/to/go-unbrick/unbrick
# Decrypted stock images: V015 system.ext4 and boot.img.
SYSTEM_EXT4=/path/to/system.ext4
BOOT_IMG=/path/to/boot.img
EMU=/path/to/gen5w-emulator
WORK=/path/to/gen5w-work
# tools/tcc803x-qemu: the patched native qemu-system-arm (build-native.sh), the extracted stock boot dir, and a qcow2
# overlay of the stock eMMC holding the "ui" savevm snapshot.
TCC_QEMU=/path/to/qemu-system-arm
TCC_BOOT_DIR=/path/to/boot
TCC_EMMC=/path/to/emmc-overlay.qcow2
# go-micomd's micom-fake binary, and optionally a micomd -record capture it takes the car's state from.
MICOM_FAKE=/path/to/micom-fake
MICOM_CAPTURE=/path/to/frames.jsonl
# go-hippod's hippo-fake binary: the GNSS module, whose time the EV schedule screens need.
HIPPO_FAKE=/path/to/hippo-fake
