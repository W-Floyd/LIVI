# Copy to .env (gitignored) and set for this machine. Absolute paths; the environment overrides these.
# A command that runs its arguments inside the pmbootstrap builder container.
PMB_EXEC=/path/to/builder exec
UNBRICK=/path/to/go-unbrick/unbrick
# Decrypted stock images: V015 system.ext4 and boot.img.
SYSTEM_EXT4=/path/to/system.ext4
BOOT_IMG=/path/to/boot.img
EMU=/path/to/gen5w-emulator
WORK=/path/to/gen5w-work
