UNBRICK=/path/to/go-unbrick/unbrick
SYSTEM_EXT4=/path/to/kia-ev6/scratch/ev6_fw/V015/system.ext4
BOOT_IMG=/path/to/kia-ev6/scratch/boot_decrypt/boot.img
EMU=/path/to/gen5w-emulator
WORK=/path/to/gen5w-work
