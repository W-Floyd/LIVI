 def run(args, **kwargs):
     return subprocess.run([str(x) for x in args], check=True, **kwargs)
+
+
+def sparse_copy(src, dst):
+    # GNU cp on Linux; macOS cp has neither flag but clones sparse files with -c.
+    flags = ["-c"] if sys.platform == "darwin" else ["--reflink=auto", "--sparse=always"]
+    run(["cp", *flags, "--", src, dst])
 
 
