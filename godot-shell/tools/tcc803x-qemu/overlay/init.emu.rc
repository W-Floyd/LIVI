# Emulator additions, imported from init.rc by build-ramdisk.py.
on early-init
    write /proc/sys/kernel/panic_on_oops 0

on init
    insmod /qfb.ko

# No Mali/VIOC in QEMU: hide the vendor EGL (the loader falls back to the software
# libGLES_android) and let the stock fbdev gralloc stand in for the Telechips one.
on post-fs
    mount tmpfs tmpfs /system/vendor/lib/egl nosuid nodev
    mount none /system/lib/hw/gralloc.default.so /system/lib/hw/gralloc.tcc803x.so bind
    mount none /dev/null /system/lib/hw/hwcomposer.tcc803x.so bind
