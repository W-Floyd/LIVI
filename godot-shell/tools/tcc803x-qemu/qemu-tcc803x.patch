diff --git a/hw/arm/tcc803x.c b/hw/arm/tcc803x.c
new file mode 100644
index 0000000..7c8695e
--- /dev/null
+++ b/hw/arm/tcc803x.c
@@ -0,0 +1,261 @@
+/*
+ * Telechips TCC803x (Kia EV6 Gen5W head unit) experimental machine.
+ *
+ * Only enough to run the stock Linux 3.18 AArch32 kernel: Cortex-A15 stand-in
+ * for the A53 cluster, GIC-400 at the real addresses, PL011 UARTs, generic
+ * timer, PSCI over SMC, and stubs for everything else.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/boards.h"
+#include "hw/arm/boot.h"
+#include "hw/char/pl011.h"
+#include "hw/intc/arm_gic.h"
+#include "hw/misc/unimp.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "hw/sd/sd.h"
+#include "hw/sd/sdhci.h"
+#include "hw/block/block.h"
+#include "system/blockdev.h"
+#include "system/system.h"
+#include "exec/address-spaces.h"
+#include "target/arm/cpu.h"
+#include "target/arm/gtimer.h"
+#include "ui/console.h"
+#include "ui/qemu-pixman.h"
+#include "migration/vmstate.h"
+
+#define TCC_RAM_BASE   0x20000000
+#define TCC_GIC_DIST   0x17301000
+#define TCC_GIC_CPU    0x17302000
+#define TCC_NUM_IRQS   224
+#define TCC_MAX_CPUS   4
+
+#define TCC_SDHC0_BASE 0x16440000
+#define TCC_SDHC0_SPI 74
+
+#define TCC_UART_BASE  0x16600000
+#define TCC_UART_SPI   88
+
+/*
+ * Simple scan-out device for the "qfb" guest module (tools/tcc803x-qemu/qfb):
+ * 32 MiB of VRAM at TCC_QFB_VRAM and a few registers the guest sets on
+ * set_par/pan. Stands in for the Telechips VIOC display pipeline.
+ */
+#define TCC_QFB_VRAM  0x70000000
+#define TCC_QFB_REGS  0x72000000
+#define TCC_QFB_SIZE  0x02000000
+
+#define TYPE_TCC_QFB "tcc803x-qfb"
+OBJECT_DECLARE_SIMPLE_TYPE(QfbState, TCC_QFB)
+
+struct QfbState {
+    SysBusDevice parent_obj;
+    MemoryRegion vram, regs;
+    QemuConsole *con;
+    uint32_t r[8];      /* 0 width, 1 height, 2 stride, 3 byte offset, 4 fmt (0 BGRX, 1 RGBX) */
+    uint32_t cur[5];
+    DisplaySurface *ds;
+};
+
+static uint64_t qfb_reg_read(void *opaque, hwaddr addr, unsigned size)
+{
+    QfbState *s = opaque;
+    return addr < sizeof(s->r) * 4 ? s->r[addr / 4] : 0;
+}
+
+static void qfb_reg_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    QfbState *s = opaque;
+    if (addr < sizeof(s->r) * 4) {
+        s->r[addr / 4] = val;
+    }
+}
+
+static const MemoryRegionOps qfb_reg_ops = {
+    .read = qfb_reg_read,
+    .write = qfb_reg_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void qfb_update(void *opaque)
+{
+    QfbState *s = opaque;
+    uint8_t *p = memory_region_get_ram_ptr(&s->vram);
+
+    if (!s->r[0] || !s->r[1] || !s->r[2] ||
+        (uint64_t)s->r[3] + (uint64_t)s->r[1] * s->r[2] > TCC_QFB_SIZE) {
+        return;
+    }
+    if (!s->ds || memcmp(s->cur, s->r, sizeof(s->cur))) {
+        memcpy(s->cur, s->r, sizeof(s->cur));
+        s->ds = qemu_create_displaysurface_from(
+            s->r[0], s->r[1], s->r[4] ? PIXMAN_x8b8g8r8 : PIXMAN_x8r8g8b8,
+            s->r[2], p + s->r[3]);
+        dpy_gfx_replace_surface(s->con, s->ds);
+    }
+    dpy_gfx_update_full(s->con);
+}
+
+static const GraphicHwOps qfb_ops = {
+    .gfx_update = qfb_update,
+};
+
+static void qfb_realize(DeviceState *dev, Error **errp)
+{
+    QfbState *s = TCC_QFB(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_ram(&s->vram, OBJECT(s), "qfb.vram", TCC_QFB_SIZE,
+                           &error_fatal);
+    memory_region_init_io(&s->regs, OBJECT(s), &qfb_reg_ops, s, "qfb.regs",
+                          0x1000);
+    sysbus_init_mmio(sbd, &s->vram);
+    sysbus_init_mmio(sbd, &s->regs);
+    s->con = graphic_console_init(dev, 0, &qfb_ops, s);
+}
+
+/* The VRAM is a RAM block and migrates by itself; the surface is rebuilt from r[]. */
+static const VMStateDescription qfb_vmstate = {
+    .name = TYPE_TCC_QFB,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(r, QfbState, 8),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void qfb_class_init(ObjectClass *oc, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+    dc->realize = qfb_realize;
+    dc->vmsd = &qfb_vmstate;
+}
+
+static const TypeInfo qfb_info = {
+    .name = TYPE_TCC_QFB,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(QfbState),
+    .class_init = qfb_class_init,
+};
+
+static void qfb_register_types(void)
+{
+    type_register_static(&qfb_info);
+}
+type_init(qfb_register_types)
+
+static struct arm_boot_info tcc803x_binfo;
+
+static void tcc803x_init(MachineState *machine)
+{
+    MemoryRegion *sysmem = get_system_memory();
+    MemoryRegion *ram = machine->ram;
+    int n, ncpus = machine->smp.cpus;
+    DeviceState *gic;
+    SysBusDevice *gicbus;
+
+    memory_region_add_subregion(sysmem, TCC_RAM_BASE, ram);
+
+    for (n = 0; n < ncpus; n++) {
+        Object *cpuobj = object_new(machine->cpu_type);
+        object_property_set_bool(cpuobj, "has_el3", false, &error_abort);
+        object_property_set_bool(cpuobj, "has_el2", false, &error_abort);
+        object_property_set_int(cpuobj, "psci-conduit", QEMU_PSCI_CONDUIT_SMC,
+                                &error_abort);
+        object_property_set_int(cpuobj, "mp-affinity", n, &error_abort);
+        if (n) {
+            object_property_set_bool(cpuobj, "start-powered-off", true,
+                                     &error_abort);
+        }
+        qdev_realize_and_unref(DEVICE(cpuobj), NULL, &error_fatal);
+    }
+
+    gic = qdev_new(TYPE_ARM_GIC);
+    qdev_prop_set_uint32(gic, "revision", 2);
+    qdev_prop_set_uint32(gic, "num-cpu", ncpus);
+    qdev_prop_set_uint32(gic, "num-irq", TCC_NUM_IRQS + 32);
+    gicbus = SYS_BUS_DEVICE(gic);
+    sysbus_realize_and_unref(gicbus, &error_fatal);
+    sysbus_mmio_map(gicbus, 0, TCC_GIC_DIST);
+    sysbus_mmio_map(gicbus, 1, TCC_GIC_CPU);
+
+    for (n = 0; n < ncpus; n++) {
+        DeviceState *cpudev = DEVICE(qemu_get_cpu(n));
+        int ppibase = TCC_NUM_IRQS + n * 32;
+        /* PPI 13/14/11/10: secure phys, phys, virt, hyp (vendor DT). */
+        qdev_connect_gpio_out(cpudev, GTIMER_SEC,
+                              qdev_get_gpio_in(gic, ppibase + 16 + 13));
+        qdev_connect_gpio_out(cpudev, GTIMER_PHYS,
+                              qdev_get_gpio_in(gic, ppibase + 16 + 14));
+        qdev_connect_gpio_out(cpudev, GTIMER_VIRT,
+                              qdev_get_gpio_in(gic, ppibase + 16 + 11));
+        qdev_connect_gpio_out(cpudev, GTIMER_HYP,
+                              qdev_get_gpio_in(gic, ppibase + 16 + 10));
+        sysbus_connect_irq(gicbus, n, qdev_get_gpio_in(cpudev, ARM_CPU_IRQ));
+        sysbus_connect_irq(gicbus, n + ncpus,
+                           qdev_get_gpio_in(cpudev, ARM_CPU_FIQ));
+    }
+
+    /* Catch-all, below every real device: reads 0, writes ignored, logged. */
+    create_unimplemented_device("tcc803x-lowio", 0x00000000, 0x10000000);
+    create_unimplemented_device("tcc803x-io", 0x10000000, 0x10000000);
+
+    for (n = 0; n < 4; n++) {
+        pl011_create(TCC_UART_BASE + n * 0x10000,
+                     qdev_get_gpio_in(gic, TCC_UART_SPI + n),
+                     serial_hd(n));
+    }
+
+    /* SDHC0: the stock firmware's eMMC (-drive if=sd,index=0). */
+    {
+        DeviceState *sdhci = qdev_new(TYPE_SYSBUS_SDHCI);
+        DriveInfo *di = drive_get(IF_SD, 0, 0);
+        DeviceState *card;
+
+        qdev_prop_set_uint8(sdhci, "sd-spec-version", 3);
+        qdev_prop_set_bit(sdhci, "ignore-sdclk-gate", true);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(sdhci), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(sdhci), 0, TCC_SDHC0_BASE);
+        sysbus_connect_irq(SYS_BUS_DEVICE(sdhci), 0,
+                           qdev_get_gpio_in(gic, TCC_SDHC0_SPI));
+        card = qdev_new(TYPE_EMMC);
+        if (di) {
+            qdev_prop_set_drive_err(card, "drive", blk_by_legacy_dinfo(di),
+                                    &error_fatal);
+        }
+        qdev_realize_and_unref(card, qdev_get_child_bus(sdhci, "sd-bus"),
+                               &error_fatal);
+    }
+
+    {
+        DeviceState *fb = qdev_new(TYPE_TCC_QFB);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(fb), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(fb), 0, TCC_QFB_VRAM);
+        sysbus_mmio_map(SYS_BUS_DEVICE(fb), 1, TCC_QFB_REGS);
+    }
+
+    tcc803x_binfo.loader_start = TCC_RAM_BASE;
+    tcc803x_binfo.ram_size = machine->ram_size;
+    tcc803x_binfo.board_id = 0xffffffff;
+    tcc803x_binfo.psci_conduit = QEMU_PSCI_CONDUIT_SMC;
+    arm_load_kernel(ARM_CPU(first_cpu), machine, &tcc803x_binfo);
+}
+
+static void tcc803x_machine_init(MachineClass *mc)
+{
+    mc->desc = "Telechips TCC803x (Kia EV6 Gen5W), experimental";
+    mc->init = tcc803x_init;
+    mc->max_cpus = TCC_MAX_CPUS;
+    mc->default_cpus = TCC_MAX_CPUS;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a15");
+    mc->default_ram_size = 0x40000000;
+    mc->default_ram_id = "tcc803x.ram";
+}
+
+DEFINE_MACHINE("tcc803x", tcc803x_machine_init)
